# Mẫu file .env. Copy thành .env rồi điền giá trị. KHÔNG commit .env.
# Quy ước: KEY=value, không có dấu cách quanh dấu =, không để chú thích sau giá trị
# (python-dotenv sẽ coi "#..." là một phần của giá trị).

# ---- Bắt buộc ở production (config/settings/production.py + apps/core/checks.py kiểm tra) ----
# Sinh key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Nhiều host cách nhau bằng dấu phẩy. Không dùng "*" (WebSocket sẽ nhận mọi origin).
ALLOWED_HOSTS=ten-mien.com,www.ten-mien.com
# Postgres. Để trống ở máy dev -> tự dùng sqlite (db.sqlite3).
DATABASE_URL=postgres://user:password@host:5432/dbname
# Redis cho Channels. Để trống ở máy dev -> InMemoryChannelLayer.
REDIS_URL=redis://host:6379/0
# Cloudinary lưu ảnh upload. Để trống cả 3 ở máy dev -> lưu vào thư mục media/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Tuỳ chọn ----
# development.py mặc định DEBUG=True, production.py luôn False.
DEBUG=False
SITE_ID=1
# Chỉ bật nếu reverse proxy KHÔNG tự redirect http->https.
SECURE_SSL_REDIRECT=False
# Đặt False nếu Postgres không có SSL (mặc định: bật khi DATABASE_URL là postgres).
# DATABASE_SSL_REQUIRE=True

# ---- Email (luồng quên mật khẩu). development.py luôn in mail ra console. ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Gmail: dùng App Password, không phải mật khẩu thường.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- Đăng nhập Google (allauth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
